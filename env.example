# AWS IoT Core Configuration
# Copy this file to .env and fill in your actual values

# AWS IoT endpoint (found in AWS IoT Console -> Settings)
AWS_IOT_ENDPOINT=a2jxq81rsqt8vu-ats.iot.us-east-1.amazonaws.com

# AWS Region
AWS_REGION=us-east-1

# AWS IoT Client ID (can be any unique identifier)
AWS_IOT_CLIENT_ID=iotconsole-42003a69-5bde-42d1-aba3-46dd56ed0594

# MQTT Topic to subscribe to
AWS_IOT_TOPIC=devices/esp32/sensors

# Certificate paths (relative to project root)
# Generate these from AWS IoT Console -> Security -> Certificates -> Create
AWS_IOT_PRIVATE_KEY_PATH=./certs/private.key
AWS_IOT_CERTIFICATE_PATH=./certs/certificate.pem
AWS_IOT_CA_PATH=./certs/AmazonRootCA1.pem

# Server configuration
PORT=3000

